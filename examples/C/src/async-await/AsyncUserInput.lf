/**
 * This program shows how to use `lf_async` in a reaction to make a blocking call to a C function
 * without blocking the execution of other reactions nor the advancement of the current tag. The
 * `getline` function defined in the `<stdio.h>` header file blocks until the user provides input.
 * This function is invoked as follows:
 * ```
 *   char* line = NULL;
 *   size_t capacity = 0;
 *   int nread = lf_async(awake, getline, &line, &capacity, stdin);
 * ```
 * where `awake` is a physical action. The reaction containing this call is triggered at startup
 * and loops forever (or until the user provides an EOF, Control-D). Because `awake` is a physical
 * action, the logical time after `lf_async` returns will be the physical time at which the user
 * provides input. If a logical action had been used instead, then the logical time would have
 * advanced by a fixed amount, the `min_delay` of the action or one microstep if no `min_delay` is
 * specified.
 *
 * To show that this blocking call does not block other reactions, every five seconds, a reaction
 * executes to prompt the user for input.
 */
target C {
  keepalive: true
}

reactor UserInput {
  preamble {=
    #include <stdio.h>
    #include <stdlib.h>
  =}
  timer t(0, 5 s)
  output out: char*
  state count: int
  physical action awake

  // The following reaction is required to precede the reaction that awaits the physical action.
  // It causes that reaction to resume at the logical time of the physical action.
  reaction(awake) {=
    lf_async_resume(awake);
  =}

  reaction(startup) -> out, awake {=
    lf_print("Control-D to exit.");
    while (true) {
      char* line = NULL;
      size_t capacity = 0;
      int nread = lf_async(awake, getline, &line, &capacity, stdin);
      if (nread < 0) {
        lf_print("User input: EOF");
        free(line);
        lf_request_stop();
        break;
      }
      if (nread > 0 && line[nread - 1] == '\n') {
        line[nread - 1] = '\0';
      }
      lf_set(out, line);
    }
  =}

  reaction(t) -> out {=
    char* prompt = NULL;
    asprintf(&prompt, "%d: Waiting for input...", self->count++);
    lf_set(out, prompt);
  =}
}

main reactor {
  async = new UserInput()

  reaction(async.out) {=
    lf_print("At logical time " PRINTF_TIME ", Line: %s", lf_time_logical_elapsed(), async.out->value);
  =}
}
