/**
 * This program shows how to use `lf_await` in a reaction to wait for an input that will be provided
 * at a future logical time. The feedback path has an `after` delay of 100 ms, which means that the
 * `DoWork` reaction has a logical execution time (LET) of 100 ms. The `RequestWork` reaction sends
 * an output to request work and then awaits the result. While it waits, logical time can advance
 * and other reactions can execute.
 *
 * Prior to the introduction of `lf_await`, the `RequestWork` reaction would have to respond to the
 * result in a separate reaction. Here, it responds in the same reaction, which enables it to use
 * any variables that may have been put on the stack prior to the `lf_await` call after the
 * `lf_await` call returns. Without `lf_await`, the `RequestWork` reaction would have to store in
 * state variables anything it wants to use after getting the result (this is called "stack
 * ripping").
 */
target Python {
  timeout: 1 s
}

reactor RequestWork {
  input result
  output request
  timer t(0, 200 ms)
  state count = 1

  # The following reaction is required to precede the reaction that awaits the result.
  # It causes that reaction to resume at the logical time of the result.
  reaction(result) {=
    self.lf_await_resume(result)
  =}

  reaction(t) result -> request {=
    print(f"Request work at logical time {lf.time.logical_elapsed()}")
    request.set(self.count)
    self.count += 1
    self.lf_await(result)
    print(f"Result {result.value} received at logical time {lf.time.logical_elapsed()}")
  =}
}

reactor DoWork {
  input request
  output result

  reaction(request) -> result {=
    print(f"Do work starting at logical time {lf.time.logical_elapsed()}")
    result.set(request.value * 2)
  =}
}

main reactor {
  request_work = new RequestWork()
  process_work = new DoWork()
  request_work.request -> process_work.request
  process_work.result -> request_work.result after 100 ms
}
